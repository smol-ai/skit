{
  "name": "skit-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "prepare": "pnpm build",
    "test": "vitest run --config vitest.lint.config.ts && pnpm -r --if-present test",
    "test:ci": "vitest run --config vitest.lint.config.ts && pnpm -r --if-present test",
    "test:e2e": "pnpm build && pnpm --fail-if-no-match --filter @smolai/skit-server-effect test:e2e",
    "test:e2e:live": "pnpm build && pnpm --filter @smolai/skit test:e2e:live",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm --parallel --no-bail --include-workspace-root run /^lint:/",
    "lint:code": "oxlint .",
    "lint:unused": "node scripts/check-unused.mjs",
    "lint:structure": "node scripts/check-structure.mjs",
    "skit": "node packages/cli/bin/skit.js",
    "vm": "pnpm --filter @smolai/skit-devtools vm",
    "tui": "pnpm --filter @smolai/skit-tui dev",
    "cli:stories": "pnpm --filter @smolai/skit-storybook start",
    "cli:stories:print": "pnpm --filter @smolai/skit stories",
    "cli:stories:watch": "pnpm --filter @smolai/skit stories:watch",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "check:ci": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test:ci && pnpm --fail-if-no-match --filter @smolai/skit-server-effect test:e2e",
    "test:collections": "pnpm --filter @smolai/skit test:collections",
    "cli:image": "bun packages/storybook/src/image/main.ts"
  },
  "devDependencies": {
    "knip": "^6.44.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "skills": "1.5.26",
    "typescript": "7.0.2",
    "typescript-parser": "npm:typescript@5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "packageManager": "pnpm@11.23.0"
}
