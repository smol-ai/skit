{
  "name": "@smolai/skit-storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Slop devtool for rapidly inspecting SKIT CLI output and interaction fixtures",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "vitest run && bun scripts/playback-smoke.ts",
    "test:preview": "bun scripts/playback-smoke.ts",
    "typecheck": "tsc --noEmit",
    "image": "bun src/image/main.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.3",
    "@opentui/core": "0.5.9",
    "@smolai/skit": "workspace:*",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "24.10.1",
    "ansi-to-html": "^0.7.2",
    "playwright": "^1.64.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
