{
  "name": "@smolai/skit-storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Slop devtool for rapidly inspecting SKIT CLI output and interaction fixtures",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@opentui/core": "0.5.9",
    "@smolai/skit": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
