{
  "$id": "skit.recovery.v1",
  "type": "object",
  "properties": {
    "operationId": {
      "type": "string"
    },
    "directory": {
      "type": "string"
    },
    "planId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "recoveryPath": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "Directory",
              "SymbolicLink"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "saved",
              "at-original",
              "missing",
              "conflict"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "path",
          "recoveryPath",
          "type",
          "status",
          "reason"
        ],
        "additionalProperties": true
      }
    },
    "legacy": {
      "type": "boolean"
    },
    "phase": {
      "type": "string",
      "enum": [
        "inspection",
        "preview",
        "restored",
        "partial",
        "conflicted",
        "stale",
        "failed"
      ]
    },
    "failure": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effect": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "required": [
          "rel",
          "argv",
          "effect"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "operationId",
    "directory",
    "planId",
    "entries",
    "legacy",
    "phase",
    "actions"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
