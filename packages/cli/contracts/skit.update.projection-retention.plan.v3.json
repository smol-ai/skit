{
  "$id": "skit.update.projection-retention.plan.v3",
  "type": "object",
  "properties": {
    "revision": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "skill_name": {
      "type": "string"
    },
    "previous_skill_version_id": {
      "type": "string"
    },
    "selected_installed_skill_id": {
      "type": "string"
    },
    "current_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "original_path": {
      "type": "string"
    },
    "import_required": {
      "type": "boolean"
    },
    "installed_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "installed_skill_id": {
            "type": "string"
          },
          "destination": {
            "type": "string",
            "enum": [
              "agents",
              "claude",
              "legacy"
            ]
          },
          "path": {
            "type": "string"
          },
          "current_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "agreement": {
            "type": "string",
            "enum": [
              "selected",
              "identical",
              "different"
            ]
          }
        },
        "required": [
          "installed_skill_id",
          "destination",
          "path",
          "current_digest",
          "agreement"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "revision",
    "skill_id",
    "skill_name",
    "previous_skill_version_id",
    "selected_installed_skill_id",
    "current_digest",
    "snapshot_digest",
    "original_path",
    "import_required",
    "installed_skills"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
