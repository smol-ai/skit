{
  "$id": "skit.update.projection-retention.v3",
  "type": "object",
  "properties": {
    "skill_id": {
      "type": "string"
    },
    "skill_name": {
      "type": "string"
    },
    "previous_skill_version_id": {
      "type": "string"
    },
    "imported_skill_version_id": {
      "type": "string"
    },
    "collection_version_id": {
      "type": "string"
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "imported": {
      "type": "boolean"
    },
    "installed_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "installed_skill_id": {
            "type": "string"
          },
          "destination": {
            "type": "string",
            "enum": [
              "agents",
              "claude",
              "legacy"
            ]
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "installed",
              "conflicted",
              "deferred"
            ]
          }
        },
        "required": [
          "installed_skill_id",
          "destination",
          "path",
          "status"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "skill_id",
    "skill_name",
    "previous_skill_version_id",
    "imported_skill_version_id",
    "collection_version_id",
    "snapshot_digest",
    "imported",
    "installed_skills"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
