{
  "$id": "skit.enable.plan.v8",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string"
    },
    "collection_label": {
      "type": "string"
    },
    "collection_source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "github",
            "git",
            "registry",
            "url",
            "archive",
            "local",
            "authored-workspace",
            "well-known"
          ]
        },
        "name": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "workspace_status": {
          "type": "string",
          "enum": [
            "connected",
            "unconnected",
            "unavailable",
            "identity-mismatch"
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "locator"
      ],
      "additionalProperties": true
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "global"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "repository"
              ]
            },
            "root": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "root"
          ],
          "additionalProperties": true
        }
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "enable"
      ]
    },
    "invocation": {
      "type": "string"
    },
    "changed": {
      "type": "boolean"
    },
    "repair": {
      "type": "boolean"
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "harness": {
            "type": "string"
          },
          "canonicalPath": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "via": {
                  "type": "string",
                  "enum": [
                    "symlink",
                    "directory",
                    "unknown-root"
                  ]
                },
                "linkPath": {
                  "type": "string"
                },
                "linkTarget": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "via"
              ],
              "additionalProperties": true
            }
          },
          "documentHash": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "harness",
          "canonicalPath",
          "aliases",
          "documentHash"
        ],
        "additionalProperties": true
      }
    },
    "unmanaged_destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "enum": [
              "agents",
              "claude"
            ]
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "destination",
          "path"
        ],
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "_tag": {
                    "type": "string",
                    "enum": [
                      "EntryLimitExceeded"
                    ]
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "count": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "_tag",
                  "limit",
                  "count"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "_tag": {
                    "type": "string",
                    "enum": [
                      "Unreadable"
                    ]
                  },
                  "error": {
                    "type": "object",
                    "properties": {
                      "_tag": {
                        "type": "string",
                        "enum": [
                          "PlatformError"
                        ]
                      },
                      "reason": {
                        "type": "object",
                        "properties": {
                          "_tag": {
                            "type": "string",
                            "enum": [
                              "AlreadyExists",
                              "BadResource",
                              "Busy",
                              "InvalidData",
                              "NotFound",
                              "PermissionDenied",
                              "TimedOut",
                              "UnexpectedEof",
                              "Unknown",
                              "WouldBlock",
                              "WriteZero",
                              "BadArgument"
                            ]
                          },
                          "module": {
                            "type": "string"
                          },
                          "method": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "syscall": {
                            "type": "string"
                          },
                          "pathOrDescriptor": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "number"
                              }
                            ]
                          }
                        },
                        "required": [
                          "_tag",
                          "module",
                          "method"
                        ],
                        "additionalProperties": true
                      }
                    },
                    "required": [
                      "_tag",
                      "reason"
                    ],
                    "additionalProperties": true
                  }
                },
                "required": [
                  "_tag",
                  "error"
                ],
                "additionalProperties": true
              }
            ]
          }
        },
        "required": [
          "path",
          "reason"
        ],
        "additionalProperties": true
      }
    },
    "enabled": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "collection": {
                "type": "string"
              }
            },
            "required": [
              "collection"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "skill": {
                "type": "string"
              }
            },
            "required": [
              "skill"
            ],
            "additionalProperties": true
          }
        ]
      }
    },
    "invocation_policies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "explicit",
          "implicit",
          "host-policy"
        ]
      }
    }
  },
  "required": [
    "subject_id",
    "skills",
    "scope",
    "action",
    "changed",
    "enabled"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
