              "type": "string",
              "enum": [
                "Device"
              ]
            }
          },
          "required": [
            "_tag"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "Repository"
              ]
            },
            "root": {
              "type": "string"
            }
          },
          "required": [
            "_tag",
            "root"
          ],
          "additionalProperties": true
        }
      ]
    },
    "UndoConflict": {
      "anyOf": [
        {
          "$ref": "#/definitions/DiscoveryRestoreConflict"
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "UnsupportedOperation"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "recovery",
                "apply",
                "sync",
                "pending"
              ]
            }
          },
          "required": [
            "_tag",
            "kind"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "SelectionChanged"
              ]
            },
            "scope": {
              "$ref": "#/definitions/UndoScope"
            },
            "key": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "enabled",
                "invocation"
              ]
            }
          },
          "required": [
            "_tag",
            "scope",
            "key",
            "kind"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
