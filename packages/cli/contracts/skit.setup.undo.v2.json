{
  "$id": "skit.setup.undo.v2",
  "type": "object",
  "properties": {
    "operationId": {
      "type": "string"
    },
    "planId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "conflicted",
        "undone",
        "already-undone"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "preview",
        "applied",
        "stale",
        "failed"
      ]
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/UndoConflict"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "release-ownership",
              "restore",
              "remove-created"
            ]
          }
        },
        "required": [
          "path",
          "kind"
        ],
        "additionalProperties": true
      }
    },
    "intentChanged": {
      "type": "boolean"
    },
    "settingsChanged": {
      "type": "boolean"
    },
    "sourceSelections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "collectionId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "fromSnapshot": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "toSnapshot": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "collectionId",
          "label",
          "fromSnapshot",
          "toSnapshot"
        ],
        "additionalProperties": true
      }
    },
    "backupId": {
      "type": "string"
    },
    "failure": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effect": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "required": [
          "rel",
          "argv",
          "effect"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "operationId",
    "status",
    "phase",
    "conflicts",
    "files",
    "intentChanged",
    "settingsChanged",
    "sourceSelections",
    "actions"
  ],
  "additionalProperties": true,
  "definitions": {
    "DiscoveryRestoreConflict": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "MachineChanged"
              ]
            }
          },
          "required": [
            "_tag"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "DiscoveryFoldersChanged"
              ]
            }
          },
          "required": [
            "_tag"
          ],
          "additionalProperties": true
        }
      ]
    },
    "UndoScope": {
      "anyOf": [
        {
          "type": "object",
