{
  "$id": "skit.library.sync.v11",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "clean",
        "push_ready",
        "pushed",
        "pull_ready",
        "pulled",
        "local_bytes_changed",
        "adoption_required",
        "adoption_ready",
        "merge_ready",
        "merged",
        "conflicted",
        "base_mismatch",
        "resolution_invalid",
        "enablement_incomplete"
      ]
    },
    "changed": {
      "type": "boolean"
    },
    "revision_id": {
      "type": "string"
    },
    "snapshots": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ]
        }
      ]
    },
    "hash": {
      "type": "string"
    },
    "installed": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ]
        }
      ]
    },
    "uninstalled": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ]
        }
      ]
    },
    "collections_to_remove": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ]
        }
      ]
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflict_details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "take-remote",
              "keep-enabled",
              "local"
            ]
          }
        },
        "required": [
          "key",
          "message",
          "resolution"
        ],
        "additionalProperties": true
      }
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "clean",
        "pulled",
        "pushed",
        "merged"
      ]
    },
    "enablement_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan": {
      "type": "object",
      "properties": {
        "local": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "collection"
                    ]
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "add",
                      "update",
                      "remove"
                    ]
                  },
                  "subject_id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "label_before": {
                    "type": "string"
                  },
                  "label_after": {
                    "type": "string"
                  },
                  "skills_added": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "skills_removed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "skills_changed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence_only": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "action",
                  "subject_id",
                  "label",
                  "skills_added",
                  "skills_removed",
                  "skills_changed",
                  "evidence_only"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "enabled"
                    ]
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "add",
                      "update",
                      "remove"
                    ]
                  },
                  "items_added": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "collection",
                            "skill"
                          ]
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "label"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "items_removed": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "collection",
                            "skill"
                          ]
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "label"
                      ],
                      "additionalProperties": true
                    }
                  }
                },
                "required": [
                  "kind",
                  "action",
                  "items_added",
                  "items_removed"
                ],
                "additionalProperties": true
              }
            ]
          }
        },
        "remote": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "collection"
                    ]
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "add",
                      "update",
                      "remove"
                    ]
                  },
                  "subject_id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "label_before": {
                    "type": "string"
                  },
                  "label_after": {
                    "type": "string"
                  },
                  "skills_added": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "skills_removed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "skills_changed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence_only": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "action",
                  "subject_id",
                  "label",
                  "skills_added",
                  "skills_removed",
                  "skills_changed",
                  "evidence_only"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "enabled"
                    ]
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "add",
                      "update",
                      "remove"
                    ]
                  },
                  "items_added": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "collection",
                            "skill"
                          ]
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "label"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "items_removed": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "collection",
                            "skill"
                          ]
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "label"
                      ],
                      "additionalProperties": true
                    }
                  }
                },
                "required": [
                  "kind",
                  "action",
                  "items_added",
                  "items_removed"
                ],
                "additionalProperties": true
              }
            ]
          }
        }
      },
      "required": [
        "local",
        "remote"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "status"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
