{
  "$id": "skit.library.sync.v11",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "clean",
        "push_ready",
        "pushed",
        "pull_ready",
        "pulled",
        "local_bytes_changed",
        "merge_ready",
        "merged",
        "conflicted",
        "resolution_invalid",
        "enablement_incomplete"
      ]
    },
    "merge_base": {
      "type": "string",
      "enum": [
        "empty-first-sync",
        "empty-different-library"
      ]
    },
    "changed": {
      "type": "boolean"
    },
    "revision_id": {
      "type": "string"
    },
    "snapshots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hash": {
      "type": "string"
    },
    "installed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uninstalled": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "collections_to_remove": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflict_details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "take-remote",
              "keep-enabled",
              "local"
            ]
          }
        },
        "required": [
          "key",
          "message",
          "resolution"
        ],
        "additionalProperties": true
      }
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "clean",
        "pulled",
        "pushed",
        "merged"
      ]
    },
    "enablement_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan": {
      "type": "object",
      "properties": {
        "enabled_resolution": {
          "type": "object",
          "properties": {
            "winner": {
              "type": "string",
              "enum": [
                "local"
              ]
            },
            "collections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "collection_id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "collection_id",
                  "label"
                ],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "winner",
            "collections"
          ],
          "additionalProperties": true
        },
        "local": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "collection"
                    ]
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "add",
                      "update",
                      "remove"
                    ]
                  },
                  "subject_id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "label_before": {
                    "type": "string"
                  },
                  "label_after": {
                    "type": "string"
                  },
                  "skills_added": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "skills_removed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "skills_changed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence_only": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "action",
                  "subject_id",
                  "label",
                  "skills_added",
                  "skills_removed",
                  "skills_changed",
                  "evidence_only"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "enabled"
                    ]
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "add",
                      "update",
                      "remove"
                    ]
                  },
                  "items_added": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "collection",
                            "skill"
                          ]
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "label"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "items_removed": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "collection",
                            "skill"
                          ]
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "label"
                      ],
                      "additionalProperties": true
                    }
                  }
                },
                "required": [
                  "kind",
                  "action",
                  "items_added",
                  "items_removed"
                ],
                "additionalProperties": true
              }
            ]
          }
        },
        "remote": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "collection"
                    ]
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "add",
                      "update",
                      "remove"
                    ]
                  },
                  "subject_id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "label_before": {
                    "type": "string"
                  },
                  "label_after": {
                    "type": "string"
                  },
                  "skills_added": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "skills_removed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "skills_changed": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "evidence_only": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "action",
                  "subject_id",
                  "label",
                  "skills_added",
                  "skills_removed",
                  "skills_changed",
                  "evidence_only"
                ],
                "additionalProperties": true
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "enabled"
                    ]
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "add",
                      "update",
                      "remove"
                    ]
                  },
                  "items_added": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "collection",
                            "skill"
                          ]
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "label"
                      ],
                      "additionalProperties": true
                    }
                  },
                  "items_removed": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "collection",
                            "skill"
                          ]
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "label"
                      ],
                      "additionalProperties": true
                    }
                  }
                },
                "required": [
                  "kind",
                  "action",
                  "items_added",
                  "items_removed"
                ],
                "additionalProperties": true
              }
            ]
          }
        }
      },
      "required": [
        "local",
        "remote"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "status"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
