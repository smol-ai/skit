{
  "$id": "skit.check.v6",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "collection_id": {
        "type": "string"
      },
      "display_name": {
        "type": "string"
      },
      "retained_copies": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "retained_copy_id": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "retained_bytes_current": {
              "type": "boolean"
            }
          },
          "required": [
            "retained_copy_id",
            "digest",
            "retained_bytes_current"
          ],
          "additionalProperties": true
        }
      },
      "unresolved_skill_selections": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string",
            "enum": [
              "Infinity",
              "-Infinity",
              "NaN"
            ]
          }
        ]
      },
      "source_status": {
        "type": "string",
        "enum": [
          "current",
          "changed",
          "unverified",
          "not-applicable"
        ]
      },
      "current_snapshot_digest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "available_snapshot_digest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "acquisition_provenance": {
        "type": "boolean"
      },
      "skills_sh": {
        "type": "object",
        "properties": {
          "checked_at": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "skill_name": {
                  "type": "string"
                },
                "skill_path": {
                  "type": "string"
                },
                "hash_kind": {
                  "type": "string",
                  "enum": [
                    "computedHash",
                    "skillFolderHash"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "current",
                    "update-available",
                    "removed-upstream",
                    "lock-stale",
                    "differs-from-lock-and-upstream",
                    "unverifiable",
                    "not-applicable"
                  ]
                },
                "baseline_commit": {
                  "type": "string"
                },
                "baseline_tree": {
                  "type": "string"
                },
                "baseline_verification": {
                  "type": "string",
                  "enum": [
                    "lock-only",
                    "lock+retained-bytes"
                  ]
                },
                "upstream_commit": {
                  "type": "string"
                },
                "upstream_tree": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "skill_name",
                "status"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "checked_at",
          "members"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "collection_id",
      "display_name",
      "retained_copies",
      "unresolved_skill_selections",
      "source_status",
      "acquisition_provenance"
    ],
    "additionalProperties": true
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
