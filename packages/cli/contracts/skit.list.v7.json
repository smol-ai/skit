{
  "$id": "skit.list.v7",
  "type": "object",
  "properties": {
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject_id": {
            "type": "string"
          },
          "subject_kind": {
            "type": "string",
            "enum": [
              "collection",
              "skill"
            ]
          },
          "label": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "revision": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_updated_at": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "imported_at": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "name": {
                  "type": "string"
                },
                "skill_id": {
                  "type": "string"
                },
                "selected_skill_version_id": {
                  "type": "string"
                },
                "versions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "skill_version_id": {
                        "type": "string"
                      },
                      "artifact_digest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "skill_version_id",
                      "artifact_digest"
                    ],
                    "additionalProperties": true
                  }
                }
              },
              "required": [
                "source",
                "revision",
                "source_updated_at",
                "imported_at",
                "name",
                "skill_id",
                "versions"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "subject_id",
          "subject_kind",
          "label",
          "skills"
        ],
        "additionalProperties": true
      }
    },
    "enabled": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "collection": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "collection",
              "label"
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "skill": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "skill",
              "name"
            ],
            "additionalProperties": true
          }
        ]
      }
    },
    "enabled_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "subjects",
    "enabled",
    "enabled_skills"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
