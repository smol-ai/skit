{
  "$id": "skit.security.accept.v2",
  "type": "object",
  "properties": {
    "skill_version_id": {
      "type": "string"
    },
    "artifactContentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "audit": {
      "type": "object",
      "properties": {
        "ruleset": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "skit/skill-static-audit"
              ]
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": true
        },
        "declaredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "undeclaredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "triggerBreadth": {
          "type": "string",
          "enum": [
            "explicit_only",
            "narrow",
            "broad",
            "unbounded",
            "unknown"
          ]
        },
        "authorityEffect": {
          "type": "string",
          "enum": [
            "none",
            "narrows",
            "expands",
            "unknown"
          ]
        },
        "confirmationEffect": {
          "type": "string",
          "enum": [
            "none",
            "requires",
            "suppresses",
            "unknown"
          ]
        },
        "riskFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truncatedEvidence": {
          "type": "object",
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "nonCriticalCapabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "critical",
            "nonCriticalCapabilities"
          ],
          "additionalProperties": true
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fingerprint": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "analysisProfile": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "skit/finding/v1"
                    ]
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "skill_artifact",
                      "audited_file"
                    ]
                  },
                  "acceptanceEligible": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "scope",
                  "acceptanceEligible"
                ],
                "additionalProperties": true
              },
              "artifactContentDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "ruleId": {
                "type": "string"
              },
              "evidence": {
                "type": "string",
                "enum": [
                  "declared",
                  "deterministically_observed",
                  "statically_possible",
                  "model_suspected",
                  "not_analyzed"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "capability": {
                "type": "string"
              },
              "location": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "excerpt": {
                    "type": "string"
                  }
                },
                "required": [
                  "line",
                  "column",
                  "excerpt"
                ],
                "additionalProperties": true
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "analysisProfile",
              "artifactContentDigest",
              "ruleId",
              "evidence",
              "severity",
              "confidence",
              "location",
              "message"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "ruleset",
        "declaredCapabilities",
        "inferredCapabilities",
        "undeclaredCapabilities",
        "triggerBreadth",
        "authorityEffect",
        "confirmationEffect",
        "riskFlags",
        "truncatedEvidence",
        "findings"
      ],
      "additionalProperties": true
    },
    "assessment": {
      "type": "object",
      "properties": {
        "context": {
          "type": "string",
          "enum": [
            "author",
            "retain",
            "project",
            "publish"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "allow",
            "warn",
            "block"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "ruleIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "capabilityIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "code",
              "ruleIds",
              "capabilityIds"
            ],
            "additionalProperties": true
          }
        },
        "findingDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fingerprint": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "ruleId": {
                "type": "string"
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "unresolved",
                  "accepted"
                ]
              },
              "acceptance": {
                "type": "object",
                "properties": {
                  "fingerprint": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "artifactContentDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "skill_version_id": {
                    "type": "string"
                  },
                  "context": {
                    "type": "string",
                    "enum": [
                      "project"
                    ]
                  },
                  "principal": {
                    "type": "string"
                  },
                  "rationale": {
                    "type": "string"
                  },
                  "acceptedAt": {
                    "type": "string"
                  },
                  "expiresAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "fingerprint",
                  "artifactContentDigest",
                  "skill_version_id",
                  "context",
                  "principal",
                  "rationale",
                  "acceptedAt"
                ],
                "additionalProperties": true
              }
            },
            "required": [
              "fingerprint",
              "ruleId",
              "disposition"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "context",
        "outcome",
        "reasons",
        "findingDecisions"
      ],
      "additionalProperties": true
    },
    "acceptances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "artifactContentDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "skill_version_id": {
            "type": "string"
          },
          "context": {
            "type": "string",
            "enum": [
              "project"
            ]
          },
          "principal": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "acceptedAt": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "applicable",
              "expired",
              "stale_digest"
            ]
          }
        },
        "required": [
          "fingerprint",
          "artifactContentDigest",
          "skill_version_id",
          "context",
          "principal",
          "rationale",
          "acceptedAt",
          "status"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "skill_version_id",
    "artifactContentDigest",
    "audit",
    "assessment",
    "acceptances"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
