{
  "$id": "skit.add.preview.v4",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "plain",
        "authored"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "verbatim_path": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "verbatim_path"
        ],
        "additionalProperties": true
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "plugin-manifest-invalid",
              "plugin-member-held"
            ]
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "path",
          "message"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "kind",
    "skills"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
