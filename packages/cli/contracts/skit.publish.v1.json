{
  "$id": "skit.publish.v1",
  "type": "object",
  "properties": {
    "release": {
      "type": "object",
      "properties": {
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "archive_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "download_path": {
          "type": "string",
          "pattern": "^\\/api\\/skits\\/"
        }
      },
      "required": [
        "release_id",
        "version",
        "archive_digest",
        "download_path"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "release"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
