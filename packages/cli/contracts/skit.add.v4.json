{
  "$id": "skit.add.v4",
  "type": "object",
  "properties": {
    "collection_id": {
      "type": "string"
    },
    "skill_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retained_version_id": {
      "type": "string"
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "verbatim_path": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "verbatim_path"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "skill_ids",
    "retained_version_id",
    "snapshot_digest",
    "skills"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
