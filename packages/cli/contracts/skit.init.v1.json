{
  "$id": "skit.init.v1",
  "type": "object",
  "properties": {
    "path": {
      "type": "string"
    },
    "library_registration": {
      "type": "string",
      "enum": [
        "registered",
        "removed"
      ]
    },
    "discovered": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skillEntries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "path"
            ],
            "additionalProperties": true
          }
        },
        "readme": {
          "type": "boolean"
        },
        "git": {
          "type": "boolean"
        },
        "skillsLock": {
          "type": "object",
          "properties": {
            "present": {
              "type": "boolean"
            },
            "entries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "present",
            "entries"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "skills",
        "skillEntries",
        "readme",
        "git",
        "skillsLock"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "path",
    "library_registration"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
