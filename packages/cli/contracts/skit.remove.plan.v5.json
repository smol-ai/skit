{
  "$id": "skit.remove.plan.v5",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string"
    },
    "subject_kind": {
      "type": "string",
      "enum": [
        "collection",
        "skill"
      ]
    },
    "collection_label": {
      "type": "string"
    },
    "collection_source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "github",
            "git",
            "registry",
            "url",
            "archive",
            "local",
            "authored-workspace",
            "well-known"
          ]
        },
        "name": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "workspace_status": {
          "type": "string",
          "enum": [
            "connected",
            "unconnected",
            "unavailable",
            "identity-mismatch"
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "locator"
      ],
      "additionalProperties": true
    },
    "versions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "skills": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "global_enabled": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "repositories": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "installed_skills": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "subject_id",
    "subject_kind",
    "versions",
    "skills",
    "global_enabled",
    "repositories",
    "installed_skills"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
