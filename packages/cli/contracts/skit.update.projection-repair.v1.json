      "type": "string",
      "enum": [
        "preview",
        "installed",
        "conflicted",
        "unknown"
      ]
    },
    "backup_path": {
      "type": "string"
    },
    "backup_status": {
      "type": "string",
      "enum": [
        "saved",
        "not-needed",
        "unavailable"
      ]
    },
    "review_token": {
      "type": "string"
    }
