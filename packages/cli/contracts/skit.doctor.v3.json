      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "skillId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "harness": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "codex",
                  "claude-code",
                  "opencode",
                  "devin"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "harnesses": {
            "anyOf": [
              {
                "type": "array",
