                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "displayName": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "canonicalPath": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string"
                    },
                    "pluginId": {
                      "type": "string"
                    },
                    "skitManaged": {
                      "type": "boolean"
                    },
                    "documentDigest": {
                      "type": "string"
                    }
