{
  "$id": "skit.list.v6",
  "type": "object",
  "properties": {
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject_id": {
            "type": "string"
          },
          "subject_kind": {
            "type": "string",
            "enum": [
              "collection",
              "skill"
            ]
          },
          "label": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "revision": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_updated_at": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "acquired_at": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "name": {
                  "type": "string"
                },
                "skill_id": {
                  "type": "string"
                },
                "selected_skill_version_id": {
                  "type": "string"
                },
                "versions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "skill_version_id": {
                        "type": "string"
                      },
                      "artifact_digest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "skill_version_id",
                      "artifact_digest"
                    ],
                    "additionalProperties": true
                  }
                }
              },
              "required": [
                "source",
                "revision",
                "source_updated_at",
                "acquired_at",
                "name",
                "skill_id",
                "versions"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "subject_id",
          "subject_kind",
          "label",
          "skills"
        ],
        "additionalProperties": true
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "global"
                ]
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": true
          },
          "entries": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "collection"
                      ]
                    },
                    "collection_id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "collection_id",
                    "label"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "skill"
                      ]
                    },
                    "skill_id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "skill_id",
                    "name"
                  ],
                  "additionalProperties": true
                }
              ]
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "scope",
          "entries",
          "skills"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "subjects",
    "bindings"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
