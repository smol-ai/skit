{
  "$id": "skit.setup.comparison.v1",
  "type": "object",
  "properties": {
    "planId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "copies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "observedHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "markdown": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "path",
          "observedHash",
          "markdown",
          "truncated"
        ],
        "additionalProperties": true
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effect": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "required": [
          "rel",
          "argv",
          "effect"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "planId",
    "copies",
    "actions"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
