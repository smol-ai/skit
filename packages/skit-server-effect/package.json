{
  "name": "@smolai/skit-server-effect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm generate:migrations && tsc -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && node scripts/build.mjs",
    "deploy": "node scripts/deployment.mjs deploy",
    "deploy:setup": "node scripts/deployment.mjs setup",
    "deploy:domain": "node scripts/deployment.mjs domain",
    "dev": "pnpm generate:migrations && vite",
    "generate:migrations": "node scripts/generate-migration-manifest.mjs",
    "test": "pnpm test:deployment && vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:deployment": "node scripts/generate-migration-manifest.mjs --check && node --test scripts/deployment.test.mjs",
    "typecheck": "node scripts/generate-migration-manifest.mjs --check && tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "types:generate": "wrangler types --config wrangler.example.jsonc",
    "types:check": "wrangler types --check --config wrangler.example.jsonc",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@foldkit/ui": "^0.156.0",
    "@smolai/skit-core": "workspace:*",
    "better-auth": "1.7.1",
    "cn": "^0.3.0",
    "effect": "4.0.0-rc.112",
    "fflate": "0.8.2",
    "jsonc-parser": "3.3.1",
    "lucide": "^1.46.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.13.14",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@foldkit/vite-plugin": "0.19.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "24.10.1",
    "foldkit": "0.156.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
